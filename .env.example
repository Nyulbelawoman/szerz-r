# ---- Claude (Anthropic) ----
# Required for real AI analysis. If unset, SzerzŐr falls back to a built-in
# keyword-based demo analyzer so you can still try the full flow.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-haiku-4-5-20251001 (fast/cheap).
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Session / auth ----
# Change this in production. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Data ----
# Where the SQLite database lives. Defaults to <project>/data/szerzor.db
# DATABASE_PATH=

# ---- Fizetés (Gumroad) ----
GUMROAD_CHECKOUT_URL=
# Opcionális: Gumroad "seller_id" a webhook ellenőrzéséhez
GUMROAD_SELLER_ID=
APP_URL=http://localhost:3000

# ---- Email (Resend) ----
RESEND_API_KEY=
# Élesben cseréld a saját (igazolt) domainedre, pl. SzerzŐr <alerts@szerzor.hu>
MAIL_FROM=SzerzŐr <alerts@szerzor.com>
# Opcionális: a cron védelméhez
# CRON_SECRET=

# Admin jelszó (a /admin oldalhoz — cseréld le élesben!)
ADMIN_PASSWORD=szerzor-admin-2026

# ---- Email (reminder delivery) ----
# Optional. Reminders are logged to the server console until these are set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=SzerzŐr <alerts@szerzor.example>
